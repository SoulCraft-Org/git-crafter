  {"id": "lint", "name": "Lint", "actor": "ci", "tools": ["The repo's content lint (docs params.lint)", "Git Crafter: tools/voice_lint.py"], "rule": "Every doc passes the content lint before it merges.", "rule_ref": "https://docs.github.com/en/contributing/style-guide-and-content-model/style-guide", "metric": "docs.lint_warn", "icon": "review"},
  {"id": "map", "name": "Map", "actor": "worker", "tools": ["Each doc's area (docs params.areas)", "The README's folder map"], "rule": "Each doc names the files it covers, so a change to them flags the doc.", "rule_ref": "https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-readmes", "metric": "docs.unmapped", "icon": "repo"},
  {"id": "publish", "name": "Publish", "actor": "github", "tools": ["GitHub rendering", "The Pages build"], "rule": "A published doc has no broken link or anchor.", "rule_ref": "https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-readmes", "metric": "docs.broken_links", "icon": "push"},
