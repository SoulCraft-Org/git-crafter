[
 {
  "id": "code.loc_change_pct",
  "params": {
   "areas": [
    "tools",
    "quality",
    "quality/collectors/blockers",
    "quality/collectors/ci",
    "quality/collectors/claude",
    "quality/collectors/code",
    "quality/collectors/credits",
    "quality/collectors/desktop-app",
    "quality/collectors/docs",
    "quality/collectors/github",
    "quality/collectors/insights",
    "quality/collectors/instructions",
    "quality/collectors/lib",
    "quality/collectors/settings",
    "quality/collectors/simplicity",
    "quality/collectors/site",
    "quality/collectors/tests",
    "quality/collectors/tokens",
    "quality/collectors/tools",
    "quality/render",
    "pages",
    "actions",
    "config/quality/collectors"
   ],
   "test_suites": [
    {
     "label": "Pages",
     "runner": "node",
     "workflow": "verify.yml",
     "job": "short",
     "cover": [
      "pages"
     ]
    },
    {
     "label": "Quality",
     "runner": "node",
     "workflow": "verify.yml",
     "job": "short",
     "cover": [
      "quality",
      "config/quality/collectors"
     ]
    }
   ],
   "check": {
    "workflow": "verify.yml",
    "job": "short"
   },
   "naming": [
    {
     "rule": "snake_case tools",
     "path": "^tools/",
     "cases": [
      "snake"
     ]
    },
    {
     "rule": "kebab-case pages",
     "path": "(^|/)pages/",
     "cases": [
      "kebab",
      "route"
     ]
    },
    {
     "rule": "PascalCase components",
     "path": "\\.astro$",
     "cases": [
      "pascal"
     ]
    },
    {
     "rule": "snake_case tools",
     "path": "\\.(py|sh)$",
     "cases": [
      "snake"
     ]
    },
    {
     "rule": "kebab-case modules",
     "path": "",
     "cases": [
      "kebab"
     ]
    }
   ]
  },
  "drop": true
 },
