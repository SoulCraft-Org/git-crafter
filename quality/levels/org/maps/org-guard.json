{
 "id": "org-guard",
 "name": "Org guard",
 "why": "An organization's settings, from sign-in to the rules on every repo",
 "ideal": "Members sign in with two factors, new repos start secure, and every default branch takes changes by pull request.",
 "sources": [
  {
   "title": "GitHub Docs: Requiring two-factor authentication in your organization",
   "url": "https://docs.github.com/en/organizations/keeping-your-organization-secure/managing-two-factor-authentication-for-your-organization/requiring-two-factor-authentication-in-your-organization",
   "date": "2026-11-26"
  },
  {
   "title": "GitHub Docs: REST API endpoints for code security settings",
   "url": "https://docs.github.com/en/rest/code-security/configurations",
   "date": "2026-11-26"
  },
  {
   "title": "GitHub Docs: About rulesets",
   "url": "https://docs.github.com/en/repositories/configuring-branches-and-merges-in-your-repository/managing-rulesets/about-rulesets",
   "date": "2026-11-26"
  },
  {
   "title": "GitHub Docs: Setting base permissions for an organization",
   "url": "https://docs.github.com/en/organizations/managing-user-access-to-your-organizations-repositories/managing-repository-roles/setting-base-permissions-for-an-organization",
   "date": "2026-11-26"
  },
  {
   "title": "GitHub Docs: Best practices for using the REST API",
   "url": "https://docs.github.com/en/rest/using-the-rest-api/best-practices-for-using-the-rest-api",
   "date": "2026-11-26"
  },
  {
   "title": "GitHub Docs: Rate limits for the REST API",
   "url": "https://docs.github.com/en/rest/using-the-rest-api/rate-limits-for-the-rest-api",
   "date": "2026-11-26"
  }
 ],
 "critical_path": [
  "require",
  "members",
  "secure",
  "rules",
  "read",
  "spend"
 ],
 "steps": [
  {
   "id": "require",
   "name": "Require 2FA",
   "actor": "owner",
   "tools": [
    "Organization settings"
   ],
   "rule": "The org requires two-factor authentication of every member.",
   "rule_ref": "https://docs.github.com/en/organizations/keeping-your-organization-secure/managing-two-factor-authentication-for-your-organization/requiring-two-factor-authentication-in-your-organization",
   "metric": "org_security.two_factor_required"
  },
  {
   "id": "members",
   "name": "Members",
   "actor": "owner",
   "tools": [
    "Organization members"
   ],
   "rule": "No member is left without two-factor authentication.",
   "rule_ref": "https://docs.github.com/en/rest/orgs/members",
   "metric": "org_members.without_2fa"
  },
  {
   "id": "secure",
   "name": "New repos",
   "actor": "github",
   "tools": [
    "Code security configurations"
   ],
   "rule": "A security configuration is the default for every new repo.",
   "rule_ref": "https://docs.github.com/en/rest/code-security/configurations",
   "metric": "org_security.new_repo_security_config"
  },
  {
   "id": "rules",
   "name": "Rules",
   "actor": "github",
   "tools": [
    "Organization rulesets"
   ],
   "rule": "A ruleset on every repo guards the default branch.",
   "rule_ref": "https://docs.github.com/en/repositories/configuring-branches-and-merges-in-your-repository/managing-rulesets/about-rulesets",
   "metric": "org_rules.default_branch_guarded"
  },
  {
   "id": "read",
   "name": "Read",
   "actor": "ci",
   "tools": [
    "gh api"
   ],
   "rule": "One read of the org's settings finishes in seconds.",
   "rule_ref": "https://docs.github.com/en/rest/using-the-rest-api/best-practices-for-using-the-rest-api",
   "metric": "org_security.read_seconds"
  },
  {
   "id": "spend",
   "name": "Spend",
   "actor": "ci",
   "tools": [
    "gh api"
   ],
   "rule": "One read spends few of the hourly requests.",
   "rule_ref": "https://docs.github.com/en/rest/using-the-rest-api/rate-limits-for-the-rest-api",
   "metric": "org_rules.requests"
  }
 ]
}
